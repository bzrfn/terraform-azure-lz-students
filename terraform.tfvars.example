# Copy to terraform.tfvars only for local use. Never commit terraform.tfvars.
subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "mexicocentral"
environment     = "prod"
name_prefix     = "lz"

vnet_cidr = "10.0.0.0/16"
subnet_cidrs = {
  app       = "10.0.1.0/24"
  db        = "10.0.2.0/24"
  vm        = "10.0.3.0/24"
  endpoints = "10.0.4.0/24"
  bastion   = "10.0.5.0/24"
}

vm_size         = "Standard_B2pts_v2"
app_service_sku = "B1"
postgresql_sku  = "B_Standard_B1ms"

# Supply these securely instead of placing real values in this file:
# export TF_VAR_vm_admin_ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# export TF_VAR_postgresql_admin_password='use-a-strong-temporary-password'

